[Unit]
Description=DavisAI Markets Frankie hybrid research agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@MARKETS_DIR@/research/kalshi
EnvironmentFile=-/etc/markets/markets.env
EnvironmentFile=-/etc/markets/frankie.env
ExecStart=/usr/bin/python3 agent_frankie.py serve
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/markets/frankie
MemoryMax=2G
CPUQuota=150%
UMask=0077

[Install]
WantedBy=multi-user.target
