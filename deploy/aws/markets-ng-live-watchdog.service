[Unit]
Description=Watchdog for Markets live NG collector
After=markets-ng-live.service

[Service]
Type=oneshot
User=root
WorkingDirectory=@MARKETS_DIR@
EnvironmentFile=-/etc/markets/markets.env
ExecStart=/usr/bin/python3 research/kalshi/ng_live_watchdog.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=@MARKETS_DIR@
ReadWritePaths=/var/lib/markets/ng_live
