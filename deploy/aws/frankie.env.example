# Non-secret Frankie runtime settings. Copy to /etc/markets/frankie.env (chmod 600).
# Credentials remain in the canonical Markets credential resolver / instance role.

# Start with deterministic observation only.
FRANKIE_DETERMINISTIC_ONLY=1
FRANKIE_EVIDENCE_ROOT=/var/lib/markets/frankie/evidence

# AWS data plane.
FRANKIE_SQS_REGION=us-east-2
FRANKIE_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/ACCOUNT_ID/frankie-events
FRANKIE_EVIDENCE_BUCKET=bento-568968024170-us-east-2-an
FRANKIE_EVIDENCE_PREFIX=frankie/evidence

# Hybrid reasoning (enable only after paper manifest is READY).
FRANKIE_PRIMARY_BACKEND=bedrock
FRANKIE_CRITIC_BACKEND=openai
FRANKIE_BEDROCK_REGION=us-east-1
FRANKIE_BEDROCK_MODEL=REPLACE_WITH_APPROVED_MODEL_OR_INFERENCE_PROFILE
FRANKIE_OPENAI_MODEL=REPLACE_WITH_APPROVED_OPENAI_MODEL

# Optional path overrides.
# FRANKIE_PAPER_MANIFEST=/opt/markets/research/kalshi/frankie_paper_manifest.json
# FRANKIE_NOVEL_REGISTRY=/opt/markets/dashboard/novel_candidates.json
