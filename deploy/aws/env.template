# Runtime secrets and configuration for the durable Markets AWS box.
# Copy to /etc/markets/markets.env, fill values, and chmod 600.
# Never commit the filled file.

# Required for Databento historical and live clients. Rotate exposed keys first.
DATABENTO_API_KEY=db-REPLACE_ME

# EIA is free. DEMO_KEY works for light use; register a free personal key for durable production.
EIA_API_KEY=DEMO_KEY
NWS_USER_AGENT=DavisAI-Markets/1.0 (public-data research)

# Prefer an EC2 instance role for S3 and SSM. Static AWS keys are fallback only.
AWS_DEFAULT_REGION=us-east-2
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Branch followed by the unattended AWS code-update timer.
MARKETS_CODE_BRANCH=chatgpt/rt-ng-mbp10-collector

# Existing historical S3 destination.
# NYMEX_S3_BUCKET=bento-568968024170-us-east-2-an
# NYMEX_S3_PREFIX=nymex

# Free EIA + NOAA/NWS snapshot collector.
FREE_NG_OUT=/var/lib/markets/free_ng/latest.json
FREE_NG_S3_BUCKET=bento-568968024170-us-east-2-an
FREE_NG_S3_KEY=drivers/free_ng/latest.json

# Dedicated live NG stream. This does not invoke Historical or interfere with L1.
NG_LIVE_SYMBOL=NG.v.0
NG_LIVE_LOCAL_DIR=/var/lib/markets/ng_live
NG_LIVE_S3_BUCKET=bento-568968024170-us-east-2-an
NG_LIVE_S3_PREFIX=nymex/live/ng
NG_LIVE_UPLOAD_ENABLED=1
NG_LIVE_KEEP_LOCAL=0
NG_LIVE_HEALTH_INTERVAL=5

# Read-only dashboard view of the exact-source coach/VOXA adapter artifact.
# The source gate writes this file atomically; the desk never creates or edits it.
NG_COACH_STREAM_FILE=/var/lib/markets/ng_refine/coach_stream.json
NG_COACH_FRESH_AGE_S=60

# Watchdog restarts only the live collector when process/heartbeat health is stale.
NG_LIVE_WATCHDOG_MAX_AGE_MS=120000
NG_LIVE_WATCHDOG_START_GRACE_S=120
