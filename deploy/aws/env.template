# deploy/aws/env.template — secrets + config for the durable box. COPY to /etc/markets/markets.env on the
# box, fill in the real values, chmod 600. NEVER commit the filled copy (it holds secrets).
#
# RECOMMENDED: do NOT put AWS keys here at all. Attach an IAM INSTANCE ROLE to the box with S3 access to the
# bucket (boto3 picks the role up automatically) — then the only secret on disk is the Databento key. The
# AWS_* lines below are the FALLBACK for a box without an instance role.

# Databento (required) — the historical-data secret.
DATABENTO_API_KEY=db-REPLACE_ME

# AWS region (required either way).
AWS_DEFAULT_REGION=us-east-2

# AWS static keys — ONLY if the box has no IAM instance role. Leave unset when a role is attached.
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME

# The S3 target (defaults baked into the code; override only if the bucket/prefix changes).
# NYMEX_S3_BUCKET=bento-568968024170-us-east-2-an
# NYMEX_S3_PREFIX=nymex
