# Pull the configured Markets code branch onto the box.
[Unit]
Description=Update Markets checkout to configured branch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@RUN_USER@
WorkingDirectory=@MARKETS_DIR@
EnvironmentFile=-/etc/markets/markets.env
ExecStart=/usr/bin/env bash deploy/aws/markets-update.sh
