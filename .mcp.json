{
  "mcpServers": {
    "codebase-memory-mcp": {
      "command": "sh",
      "args": ["-c", "exec \"$HOME/.local/bin/codebase-memory-mcp\""]
    },
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws-cli@1.7.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-2",
        "--read-only"
      ]
    }
  }
}
