  "prior_information_horizons_seconds": [5, 10, 20, 30, 60, 120, 300],
  "prior_rule": {
    "predecessor_ready": "predecessor.causal_confirmation_idx + h",
    "rule_ready": "max(predecessor_ready for every predecessor required by the D-depth rule)",
    "prior_eligible": "rule_ready <= target.t0_idx",
    "prior_lead_seconds": "target.t0_idx - rule_ready",
    "availability_is_predictive_skill": false
  },
  "target_detector_confirmation_offset_seconds": 0,
  "post_detection_checkpoints_seconds": {
