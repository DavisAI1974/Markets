    "every_5_seconds_from": 20,
    "every_5_seconds_through": 3600,
    "expanded_sequence_rule": "+20,+25,+30,+35,...,+3600 while structurally alive and data are available"
  },
  "search_sequence": "PRIOR[h=5,10,20,30,60,120,300] -> +0 -> +1 -> +2 -> +3 -> +4 -> +5 -> +10 -> +15 -> +20 -> +25 -> ... -> +3600",
  "per_depth": {
    "D1": {
      "required_predecessor_count": 1,
      "prior": "test origin/predecessor information at every frozen h; PRIOR means before the D1 target descendant t0",
      "at_detection": "+0 target detector confirmation",
      "post_detection": "+1,+2,+3,+4,+5,+10,+15 then every 5 seconds from +20 through +3600"
    },
    "D2": {
      "required_predecessor_count": 2,
      "prior": "all two required predecessor states must be ready before target t0",
      "at_detection": "+0",
      "post_detection": "same universal dense grid"
    },
    "D3": {
      "required_predecessor_count": 3,
      "prior": "all three required predecessor states must be ready before target t0",
      "at_detection": "+0",
      "post_detection": "same universal dense grid"
    },
    "D4": {
      "required_predecessor_count": 4,
      "prior": "all four required predecessor states must be ready before target t0",
      "at_detection": "+0",
      "post_detection": "same universal dense grid; low support preserved"
    },
    "D5": {
      "required_predecessor_count": 5,
      "prior": "all five required predecessor states must be ready before target t0",
      "at_detection": "+0",
      "post_detection": "same universal dense grid; n=1 case only"
    }
  },
  "existing_h5_availability_reference_not_skill": {
