{
  "name": "NG exhaustion D1-D5 predictability timing grid",
  "date": "2026-08-19",
  "status": "AUTHORITATIVE_ENTRY_TIMING_REVIVAL_CONTRACT",
  "objective": "For each preserved exact D1-D5 chain/behavior, find the earliest causal moment the already-defined behavior becomes predictably callable: prior to target onset, at target detector confirmation, or at the first validating post-detection checkpoint.",
  "entry_hierarchy": [
    "PRIOR_IF_VALIDATED",
    "AT_TARGET_DETECTOR_CONFIRMATION_IF_PRIOR_FAILS",
    "FIRST_VALIDATED_POST_DETECTION_CHECKPOINT_IF_EARLIER_POINTS_FAIL",
    "NO_FORCED_TRADE_IF_NOT_ACTIONABLE"
