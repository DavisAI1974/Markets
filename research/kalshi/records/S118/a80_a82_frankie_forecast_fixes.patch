+# A-82 (S118). THE GUARD WAS SCOPED TO TOKEN NAMES, NOT TO DATES, AND SO IT BLOCKED THE RUN ON
+# LEGITIMATE PRIOR-GROUP EVIDENCE. It hard-stopped on `actual_day_move_usd` inside
+# structure.accumulation_arm_turn's evidence describing g17's 2026-04-22 - a group walked, scored
+# and merged long before g18 opens on 2026-04-27. That text is what a brain INSTANCE is, and every
+# specialist in the walk has always been served it.
+#
+# Same shape as the S114 `live_verdict` defect, which flagged 43 plays by matching "degenerate"
+# anywhere - including plays that merely DISCUSS degeneracy while concluding they are sound.
+# Matching a WORD instead of a CLAIM.
+#
+# THE INTENT WAS RIGHT AND ONLY THE REACH WAS WRONG, so this NARROWS scope; it does not relax the
+# guard. Two classes now, because they are two different risks:
+#
+#   FILE tokens (gN_actual.json, gN_rt.json) stay ABSOLUTE. Naming the forbidden artifact is never
+#   legitimate at any date - there is no evidentiary reason to cite the file itself.
+#
+#   FIELD tokens (actual_day_move_usd, actual_close) are leaks only when attached to THIS DAY OR
+#   LATER. A realized field name next to an earlier group's date is evidence; next to the packet's
+#   own day it is the answer.
+#
+# It FAILS CLOSED on ambiguity: an occurrence with no 8-digit date anywhere in its neighbourhood is
+# treated as a leak, because an unattributable realized number cannot be shown to be historical.
+# Measured on the real corpus - all 20 days of g18 and g19 - every occurrence carries dates and all
+# of them precede their group's window, so failing closed costs nothing here and protects the case
+# nobody has thought of yet.
+_LEAK_FILE_TOKENS = ("{gid}_actual.json", "{gid}_rt.json")
+_LEAK_FIELD_TOKENS = ("actual_day_move_usd", "actual_close", "actual_net_usd", "actual_gap_usd")
+_LEAK_CONTEXT = 400
+_DATE8 = re.compile(r"20\d{6}")
+
+
+def _assert_no_outcome_leak(text: str, gid: str, day: str) -> None:
+    for tmpl in _LEAK_FILE_TOKENS:
+        token = tmpl.format(gid=gid)
+        if token in text:
+            raise ForecastStop(
+                f"outcome leak: forbidden artifact {token!r} named in packet for {gid} {day}")
+    for token in _LEAK_FIELD_TOKENS:
+        start = 0
+        while True:
+            i = text.find(token, start)
+            if i < 0:
+                break
+            start = i + len(token)
+            ctx = text[max(0, i - _LEAK_CONTEXT): i + _LEAK_CONTEXT]
+            dates = _DATE8.findall(ctx)
+            if not dates:
+                raise ForecastStop(
+                    f"outcome leak: {token!r} in packet for {gid} {day} carries NO date in context - "
+                    f"an unattributable realized value cannot be shown to be historical")
+            forward = sorted({d for d in dates if d >= day})
+            if forward:
+                raise ForecastStop(
+                    f"outcome leak: {token!r} in packet for {gid} {day} is attached to {forward} - "
+                    f"this day or later")
+
+
 def _output_path_from_prompt(prompt: str, namespace: str, gid: str, spec: str, day: str,
                              template: str) -> Path:
     matches = re.findall(r"(?:OUTPUT\s*[—-]\s*write|write)\s+([A-Za-z0-9_./-]+\.json)", prompt, flags=re.I)
