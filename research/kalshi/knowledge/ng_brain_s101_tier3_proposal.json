 "scoring_split": {
  "note": "Gate item 4 (desk review B1; resolves S97 concern 5). EFFECTIVE G12.",
  "rule": "The DAY-BOOK (per-day nets, net-of-fee maker AND taker) is the PRIMARY scored product. The BLOCK LEAN is DEMOTED to a regime-state call (polarity + conviction), recorded and graded as a DESCRIPTOR and as a conditioner of day plays - never a standalone pass/fail deliverable.",
  "rationale": "Two-week directional NG calls are near-coin-flip at the best desks; COACH_REPLAY_S97: the day-book is where the edge lives (resume 9/10, fees immaterial, turn-calls 0/3); G9 proved a wrong lean does not cost the day-book money.",
  "two_coach": "Under 0c: the day-book is the NYMEX coach's product; the Kalshi coach's product is the echo book (feed M) on its OWN ledger; the two are never pooled."
 },
 "squeeze_regime_doctrine": {
  "note": "Gate item 5 (desk review B5). Scope-tagged guidance; the agent decides application; G11 is n=1 and G13 is the designed forward test.",
  "rule": "While squeeze_watch is ACTIVE (days_to_calendar_front_expiry <= 7 AND calendar-front spread positive-and-widening): demand-regime magnitude bands are OUT OF SCOPE (void, not rescaled); NO mean-reversion assumption; NEVER short the squeeze leg on band logic; alternation/day-type sequencing rules are out of scope on the squeeze leg. The unwind boundary (expiry passes / spread collapses) re-admits normal doctrine.",
  "inputs": "squeeze_watch + calendar-front fields + options walls (feed I) + cash basis + freeze_risk (supply cut during cold = the physical trigger class)."
 }
}