{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davisai.ai/schemas/frankie-event-v1.json",
  "title": "Frankie point-in-time candidate event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "candidate_id",
    "knowable_at",
    "observed_at",
    "trigger",
    "source_provenance",
    "contract_identity",
    "market_state",
    "causal_state",
    "cost_state"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "knowable_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "trigger": {"type": "string", "minLength": 1},
    "execution_enabled": {"const": false},
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["source", "knowable_at", "content_hash"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "knowable_at": {"type": "string", "format": "date-time"},
          "content_hash": {"type": "string", "minLength": 1},
          "receipt_at": {"type": "string", "format": "date-time"},
          "revision_vintage": {"type": ["string", "null"]}
        }
      }
    },
    "contract_identity": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["EXACT", "MAPPED", "NOT_APPLICABLE", "UNKNOWN", "MISMATCH"]},
        "instrument_a": {"type": ["string", "null"]},
        "instrument_b": {"type": ["string", "null"]},
        "underlying_month_a": {"type": ["string", "null"]},
        "underlying_month_b": {"type": ["string", "null"]},
        "settlement_source_a": {"type": ["string", "null"]},
        "settlement_source_b": {"type": ["string", "null"]},
        "settlement_time_a": {"type": ["string", "null"], "format": "date-time"},
        "settlement_time_b": {"type": ["string", "null"], "format": "date-time"},
        "rule_hash_a": {"type": ["string", "null"]},
        "rule_hash_b": {"type": ["string", "null"]}
      }
    },
    "market_state": {"type": "object"},
    "causal_state": {
      "type": "object",
      "required": ["clock_status", "source_fresh"],
      "properties": {
        "clock_status": {"enum": ["EXACT", "POINT_IN_TIME", "NOT_APPLICABLE", "UNKNOWN"]},
        "source_fresh": {"type": "boolean"},
        "knowable_at_basis": {"type": ["string", "null"]}
      }
    },
    "cost_state": {
      "type": "object",
      "required": ["costs_known"],
      "properties": {
        "costs_known": {"type": "boolean"},
        "fees": {"type": ["number", "null"]},
        "spread": {"type": ["number", "null"]},
        "slippage": {"type": ["number", "null"]},
        "hedge_cost": {"type": ["number", "null"]}
      }
    },
    "metadata": {"type": "object"}
  }
}
