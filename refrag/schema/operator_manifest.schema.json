{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReFRAG Operator Manifest",
  "type": "object",
  "required": [
    "$schema_version",
    "operator_id",
    "operator_name",
    "description",
    "visibility",
    "maturity",
    "execution_class",
    "operator_type",
    "inputs",
    "outputs"
  ],
  "properties": {
    "$schema_version": {
      "type": "string"
    },
    "operator_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "operator_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "internal",
        "public"
      ]
    },
    "maturity": {
      "type": "string",
      "enum": [
        "experimental",
        "candidate",
        "stable",
        "deprecated"
      ]
    },
    "execution_class": {
      "type": "string",
      "enum": [
        "runtime",
        "control_plane"
      ]
    },
    "operator_type": {
      "type": "string",
      "enum": [
        "atomic",
        "composite",
        "template"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "object",
      "properties": {
        "team": {
          "type": "string"
        },
        "maintainer": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operator_id"
        ],
        "properties": {
          "operator_id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "telemetry": {
      "type": "object"
    },
    "evaluation": {
      "type": "object"
    },
    "governance": {
      "type": "object"
    },
    "registry": {
      "type": "object"
    },
    "lineage": {
      "type": "object"
    },
    "artifacts": {
      "type": "object"
    },
    "status": {
      "type": "object"
    }
  }
}
